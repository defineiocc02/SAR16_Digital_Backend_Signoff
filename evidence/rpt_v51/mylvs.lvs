//*Define OPC
OPCB = (OPCBA OR OPCBP) OR OPCBM

//////////////////////////////////////////////
// Loigc Operation                          //
//////////////////////////////////////////////

//*Form Bulk layer
DRC:1   = EXTENT
BULK    = SIZE DRC:1 BY 1.0

//*Define Pwell layer
scut    = SIZE SUBD  BY 0.005
cutring = scut NOT SUBD
wella   = cutring OR NW
pwell   = BULK NOT wella
//pwell_wpe   = BULK NOT NW
rwella  = NW HOLES
rwellb  = rwella AND DNW
rwell1  = rwellb NOT nwell
rwell   = rwell1 NOT cutring
pwell1    = pwell AND rwell
dnwd_psub = pwell NOT pwell1
psub_all  = (BULK NOT DNW) NOT cutring
bulk_all = BULK NOT cutring
//nwell_DNW = DNW OR (nwell INTERACT DNW)

nwellring   = DONUT nwell

//pw_nw1      = ((pwell OR nwellring) INTERACT DNW) INTERACT NFDMK  //*the six terminal of dnw mos
//pw_nw2      = ((pwell OR nwellring) INTERACT DNW) INTERACT DMPNP
//pw_nw       = pw_nw1 OR pw_nw2 


//*Define original P/N diffusion Area
pdifi   = AA AND SP
ndifi   = AA AND SN

//*Divide Resistor DUMMY for SAB
hresd   = RESAA AND SAB
hresdd  = RESAA INTERACT SAB
lresd   = RESAA NOT hresdd

hresp   = RESP1 AND SAB
hrespd  = RESP1 INTERACT SAB
lresp   = RESP1 NOT hrespd

//*Define P+ Diffusion resistor
pdrsab1  = pdifi AND hresd
pdrnosab1= pdifi AND lresd

pdrsab_old      = (pdrsab1 NOT RFDEV) NOT RESCKT
pdrsab_ckt_old  = (pdrsab1 NOT RFDEV) AND RESCKT
pdrnosab_old    = (pdrnosab1 NOT RFDEV) NOT RESCKT
pdrnosab_ckt_old= (pdrnosab1 NOT RFDEV) AND RESCKT
pdrsabrf    = pdrsab1 AND RFDEV

pdr     = (((pdrsab OR pdrsab_ckt) OR pdrnosab) OR pdrnosab_ckt) OR pdrsabrf  
pdif    = pdifi NOT pdr

//*Define N+ Diffusion resistor
ndrsab1  = ndifi AND hresd 
ndrnosab1= ndifi AND lresd 

ndrsab_old      = (ndrsab1 NOT RFDEV) NOT RESCKT
ndrsab_ckt_old  = (ndrsab1 NOT RFDEV) AND RESCKT
ndrnosab_old    = (ndrnosab1 NOT RFDEV) NOT RESCKT
ndrnosab_ckt_old= (ndrnosab1 NOT RFDEV) AND RESCKT
ndrsabrf    = ndrsab1 AND RFDEV

ndr     = (((ndrsab OR ndrsab_ckt) OR ndrnosab) OR ndrnosab_ckt) OR ndrsabrf 
ndif    = ndifi NOT ndr

//*Define P+ Poly resistor
ppoly_1            = GT AND SP
pprsab_old             = (((ppoly_1 AND hresp) NOT RESP3T) NOT RFDEV) NOT RESCKT
pprsab_ckt_old         = (((ppoly_1 AND hresp) NOT RESP3T) NOT RFDEV) AND RESCKT
pprnosab_old           = (((ppoly_1 AND lresp) NOT RESP3T) NOT RFDEV) NOT RESCKT
pprnosab_ckt_old       = (((ppoly_1 AND lresp) NOT RESP3T) NOT RFDEV) AND RESCKT
pprsab_3t_old          = ((ppoly_1 AND hresp) AND RESP3T) NOT RESCKT
pprsab_3t_ckt      = ((ppoly_1 AND hresp) AND RESP3T) AND RESCKT
pprnosab_3t_old        = ((ppoly_1 AND lresp) AND RESP3T) NOT RESCKT
pprnosab_3t_ckt    = ((ppoly_1 AND lresp) AND RESP3T) AND RESCKT
pprsab_3t_nw       = pprsab_3t AND nwell
pprsab_3t_nw_ckt_old   = pprsab_3t_ckt AND nwell
pprsab_3t_pw       = pprsab_3t NOT nwell
pprsab_3t_pw_ckt_old   = pprsab_3t_ckt NOT nwell
pprnosab_3t_nw     = pprnosab_3t AND nwell
pprnosab_3t_nw_ckt_old = pprnosab_3t_ckt AND nwell
pprnosab_3t_pw     = pprnosab_3t NOT nwell
pprnosab_3t_pw_ckt_old = pprnosab_3t_ckt NOT nwell
pprsabrf           = ((ppoly_1 AND hresp) NOT RESP3T) AND RFDEV

ppr1     = ((pprsab OR pprsab_ckt) OR pprnosab) OR pprnosab_ckt 
ppr2     = ((pprsab_3t OR pprsab_3t_ckt) OR pprnosab_3t) OR pprnosab_3t_ckt 
ppr      = (ppr1 OR ppr2) OR pprsabrf

//*Define N+ Poly resistor
npoly_1            = GT AND SN
nprsab_old             = (((npoly_1 AND hresp) NOT RESP3T) NOT RFDEV) NOT RESCKT
nprsab_ckt_old         = (((npoly_1 AND hresp) NOT RESP3T) NOT RFDEV) AND RESCKT
nprnosab_old           = (((npoly_1 AND lresp) NOT RESP3T) NOT RFDEV) NOT RESCKT
nprnosab_ckt_old       = (((npoly_1 AND lresp) NOT RESP3T) NOT RFDEV) AND RESCKT
nprsab_3t_old          = ((npoly_1 AND hresp) AND RESP3T) NOT RESCKT
nprsab_3t_ckt      = ((npoly_1 AND hresp) AND RESP3T) AND RESCKT
nprnosab_3t_old        = ((npoly_1 AND lresp) AND RESP3T) NOT RESCKT
nprnosab_3t_ckt    = ((npoly_1 AND lresp) AND RESP3T) AND RESCKT
nprsab_3t_nw       = nprsab_3t AND nwell
nprsab_3t_nw_ckt_old   = nprsab_3t_ckt AND nwell
nprsab_3t_pw       = nprsab_3t NOT nwell
nprsab_3t_pw_ckt_old   = nprsab_3t_ckt NOT nwell
nprnosab_3t_nw     = nprnosab_3t AND nwell
nprnosab_3t_nw_ckt_old = nprnosab_3t_ckt AND nwell
nprnosab_3t_pw     = nprnosab_3t NOT nwell
nprnosab_3t_pw_ckt_old = nprnosab_3t_ckt NOT nwell
nprsabrf           = ((npoly_1 AND hresp) NOT RESP3T) AND RFDEV

npr1     = ((nprsab OR nprsab_ckt) OR nprnosab) OR nprnosab_ckt 
npr2     = ((nprsab_3t OR nprsab_3t_ckt) OR nprnosab_3t) OR nprnosab_3t_ckt
npr      = (npr1 OR npr2) OR nprsabrf

//*Define HRP poly resisitor

hrppoly     = GT AND HRP
hrpdums     = HRPDMY AND SAB
hrppo1      = (hrppoly AND hrpdums) NOT RESP3T
hrppo_old       = (hrppo1 NOT RFDEV) NOT RESCKT
hrppo_ckt_old   = (hrppo1 NOT RFDEV) AND RESCKT

hrppo_3t_old    = ((hrppoly AND hrpdums) AND RESP3T) NOT RESCKT
hrppo_3t_ckt= ((hrppoly AND hrpdums) AND RESP3T) AND RESCKT
hrppo_3t_nw = hrppo_3t AND nwell
hrppo_3t_nw_ckt_old = hrppo_3t_ckt AND nwell
hrppo_3t_pw = hrppo_3t NOT nwell
hrppo_3t_pw_ckt_old = hrppo_3t_ckt NOT nwell 
hrpporf = hrppo1 AND RFDEV

hrppo   = hrppo_old NOT rhrpo_none_layers
hrppo_3t        = hrppo_3t_old NOT rhrpo_none_layers
hrppo_3t_nw_ckt = hrppo_3t_nw_ckt_old NOT rhrpo_none_layers
hrppo_3t_pw_ckt = hrppo_3t_pw_ckt_old NOT rhrpo_none_layers
hrppo_ckt       = hrppo_ckt_old NOT rhrpo_none_layers

//*subtract Poly used as resistor
#IFDEF EFUSE_RES TRUE
rpoly    = (npr or ppr) or efgate
#ELSE
rpoly    = npr or ppr
#ENDIF

rpoly_1 = (((rpoly OR hrppo) OR hrppo_ckt) OR hrppo_3t) OR hrppo_3t_ckt

poly1   = GT NOT rpoly_1

//*Define Nwell Resistor
nwr         = NW AND RESNW
sabaa       = aa AND sab
nwraa_old       = ((nwr AND sabaa) NOT RESCKT) INTERACT SN 
nwraa_ckt_old   = ((nwr AND sabaa) AND RESCKT) INTERACT SN  
nwrsti_old      = ((nwr NOT sabaa) NOT RESCKT) INTERACT SN 
nwrsti_ckt_old  = ((nwr NOT sabaa) AND RESCKT) INTERACT SN
nwell       = (((NW NOT nwraa) NOT nwraa_ckt) NOT nwrsti) NOT nwrsti_ckt

//*Define Metal Resistor

#IFDEF TOPMETAL 6
rm1     = M1 AND M1R
metal1  = M1 NOT M1R
rm2     = M2 AND M2R
metal2a = M2 NOT M2R
rm3     = M3 AND M3R
metal3a = M3 NOT M3R
rm4     = M4 AND M4R
metal4a = M4 NOT M4R
rm5     = M5 AND M5R
metal5a = M5 NOT M5R
rm6     = M6 AND M6R
metal6 = M6 NOT M6R
#ENDIF

#IFDEF TOPMETAL 5
rm1     = M1 AND M1R
metal1  = M1 NOT M1R
rm2     = M2 AND M2R
metal2a = M2 NOT M2R
rm3     = M3 AND M3R
metal3a = M3 NOT M3R
rm4     = M4 AND M4R
metal4a = M4 NOT M4R
rm5     = M5 AND M5R
metal5 = M5 NOT M5R
#ENDIF

#IFDEF TOPMETAL 4
rm1     = M1 AND M1R
metal1  = M1 NOT M1R
rm2     = M2 AND M2R
metal2a = M2 NOT M2R
rm3     = M3 AND M3R
metal3a = M3 NOT M3R
rm4     = M4 AND M4R
metal4 = M4 NOT M4R
#ENDIF

#IFDEF TOPMETAL 3
rm1     = M1 AND M1R
metal1 = M1 NOT M1R
rm2     = M2 AND M2R
metal2a = M2 NOT M2R
rm3     = M3 AND M3R
metal3 = M3 NOT M3R
#ENDIF

//*Define Metal1/Poly Capacitor
pmcp1   = poly1 AND metal1
pmcap   = pmcp1 AND CAPBP

poly2   = poly1 NOT pmcap

//*Define MIM Capacitor

#IFDEF MIM_TYPE 1

#IFDEF TOPMETAL 6
mimcap1 = metal5a AND (MIM ENCLOSE V5)
mimcap_old      = mimcap1 NOT interact MIMCKT
mimcap_ckt_old  = mimcap1 interact MIMCKT
metal5 = metal5a NOT mimcap1

metal4 = copy metal4a
metal3 = copy metal3a
metal2 = copy metal2a

via5a   = V5 AND MIM
via5b   = V5 NOT via5a
via4    = copy V4
via3    = copy V3
via2    = copy V2
via1    = copy V1
#ENDIF


#IFDEF TOPMETAL 5
mimcap1  = metal4a AND (MIM ENCLOSE V4)
mimcap_old      = mimcap1 NOT interact MIMCKT
mimcap_ckt_old  = mimcap1 interact MIMCKT
metal4  = metal4a NOT mimcap1

metal3 = copy metal3a
metal2 = copy metal2a

via4a   = V4 AND MIM
via4b   = V4 NOT via4a
via3    = copy V3
via2    = copy V2
via1    = copy V1
#ENDIF

#IFDEF TOPMETAL 4
mimcap1  = metal3a AND (MIM ENCLOSE V3)
mimcap_old      = mimcap1 NOT interact MIMCKT
mimcap_ckt_old  = mimcap1 interact MIMCKT
metal3 = metal3a NOT mimcap1

metal2 = copy metal2a

via3a   = V3 AND MIM
via3b   = V3 NOT via3a
via2    = copy V2
via1    = copy V1
#ENDIF

#IFDEF TOPMETAL 3
mimcap1  = metal2a AND (MIM ENCLOSE V2)
mimcap_old      = mimcap1 NOT interact MIMCKT
mimcap_ckt_old  = mimcap1 interact MIMCKT
metal2  = metal2a NOT mimcap1

via2a   = V2 AND MIM
via2b   = V2 NOT via2a
via1    = copy V1
#ENDIF

mimcap  = mimcap_old NOT mim_none_layers
mimcap_ckt  = mimcap_ckt_old NOT mim_none_layers
#ENDIF



#IFDEF MIM_TYPE 2

#IFDEF TOPMETAL 6
mim2cap1 = metal5a AND (MIM ENCLOSE V5)
mim2cap_old      = mim2cap1 NOT interact MIMCKT
mim2cap_ckt_old  = mim2cap1 interact MIMCKT
metal5 = metal5a NOT mim2cap1

metal4 = copy metal4a
metal3 = copy metal3a
metal2 = copy metal2a

via5a   = V5 AND MIM
via5b   = V5 NOT via5a
via4    = copy V4
via3    = copy V3
via2    = copy V2
via1    = copy V1
#ENDIF


#IFDEF TOPMETAL 5
mim2cap1  = metal4a AND (MIM ENCLOSE V4)
mim2cap_old      = mim2cap1 NOT interact MIMCKT
mim2cap_ckt_old  = mim2cap1 interact MIMCKT
metal4  = metal4a NOT mim2cap1

metal3 = copy metal3a
metal2 = copy metal2a

via4a   = V4 AND MIM
via4b   = V4 NOT via4a
via3    = copy V3
via2    = copy V2
via1    = copy V1
#ENDIF

#IFDEF TOPMETAL 4
mim2cap1  = metal3a AND (MIM ENCLOSE V3)
mim2cap_old      = mim2cap1 NOT interact MIMCKT
mim2cap_ckt_old  = mim2cap1 interact MIMCKT
metal3 = metal3a NOT mim2cap1

metal2 = copy metal2a

via3a   = V3 AND MIM
via3b   = V3 NOT via3a
via2    = copy V2
via1    = copy V1
#ENDIF

#IFDEF TOPMETAL 3
mim2cap1  = metal2a AND (MIM ENCLOSE V2)
mim2cap_old      = mim2cap1 NOT interact MIMCKT
mim2cap_ckt_old  = mim2cap1 interact MIMCKT
metal2  = metal2a NOT mim2cap1

via2a   = V2 AND MIM
via2b   = V2 NOT via2a
via1    = copy V1
#ENDIF

mim2cap = mim2cap_old NOT mim2_none_layers
mim2cap_ckt = mim2cap_ckt_old NOT mim2_none_layers

#ENDIF

//*Define MOS Device
ntd1    = ndif AND nwell
ptd1    = pdif AND pwell
ndiff   = ndif AND pwell
pdiff   = pdif AND nwell

//gate    = ((ngate OR pgate) OR cngate) OR cpgate //to pass verisilicon's memory IP RASP2048X16M16, delete cpgate
gate    = (ngate OR pgate) OR cngate

ngate   = poly2 AND ndiff
pgate   = poly2 AND pdiff
cngate  = poly2 AND ntd1
cpgate  = poly2 AND ptd1

poly_int= poly2 NOT gate
npoly = poly_int AND SN
ppoly = poly_int NOT SN

efpoly1 = GT AND EFUSE
efpoly2 = efpoly1 INTERACT CT
efgate_old  = (efpoly2 AND GTFUSE) AND FUSEMK1
efpoly  = efpoly2 NOT efgate

nsd1    = ndiff NOT ngate
psd1    = pdiff NOT pgate
ntd     = ntd1 NOT cngate
ptd     = ptd1 NOT cpgate
dnwd_ptd    = ptd AND dnwd_psub

//*Define Diode terminal.
// Define N+/PW diode
dio_np  = nsd1 INSIDE DSTR
ndio    = dio_np NOT PSUB
ndio18_old  = (ndio NOT DG) NOT MVN
ndio33_old  = (ndio AND DG) NOT MVN

ndiomvt18_old = (ndio NOT DG) AND MVN
ndiomvt33_old = (ndio AND DG) AND MVN

nndio   = dio_np AND PSUB
nndio18_old = nndio NOT DG
nndio33_old = nndio AND DG

nsd2    = nsd1 NOT dio_np

// Define P+/NW Diode 
dio_pn  = psd1 INSIDE DSTR
pdio18_old  = (dio_pn NOT DG) NOT MVP
pdio33_old  = (dio_pn AND DG) NOT MVP
pdiomvt18_old = (dio_pn NOT DG) AND MVP

//*Define Buried PW/Deep NW Diode
diopsub = rwell AND DNW
diobpw_old  = ((diopsub AND DSTR) NOT DNWTR) INTERACT AA 

// Define NW/PW diode
dio_nw  = nwell INSIDE DSTR
dionw1  = dio_nw NOT INTERACT dio_pn
dionw_old   = (dionw1 NOT INTERACT DNW) INTERACT AA 

psd2    = psd1 NOT dio_pn

dnwdio_old  = (((DNW INSIDE DSTR) INTERACT pwell) AND DNWTR) INTERACT AA 

//*Parasitic Diode

parasitic_diobpw  = (((rwell NOT INTERACT ndio18) NOT INTERACT VARMOS) NOT INTERACT DMPNP) NOT diobpw
parasitic_dnwdio  = (DNW NOT INTERACT DMPNP) NOT dnwdio

parasitic_nw1   = nwell NOT dio_nw
parasitic_nw2   = parasitic_nw1 ENCLOSE pgate
parasitic_nw3   = (parasitic_nw1 INTERACT cngate) NOT INTERACT VARMOS
parasitic_nw4   = parasitic_nw1 INTERACT dio_pn
parasitic_nwdio = (((((parasitic_nw2 OR parasitic_nw3) OR parasitic_nw4) NOT INTERACT DNW) NOT INTERACT INST) NOT INTERACT DMPNP) interact dnwd_psub == 1

//*Define PNP Device
pnpemit = (psd2 AND DMPNP) NOT MOSCKT
pnpemit_ckt = (psd2 AND DMPNP) AND MOSCKT
pnpbase = nwell INTERACT (pnpemit OR pnpemit_ckt)
collsur = pwell TOUCH pnpbase
pnpcoll = collsur OR pnpbase
//pnpcoll = STAMP coll BY pwell

pnpemit18 = pnpemit NOT DG
pnpemit18_ckt = pnpemit_ckt NOT DG
pnpemit18a4_old   = AREA pnpemit18 >3.9 <4.1
pnpemit18a4_ckt_old   = AREA pnpemit18_ckt >3.9 <4.1
pnpemit18a25_old  = AREA pnpemit18 >24.9 <25.1
pnpemit18a25_ckt_old  = AREA pnpemit18_ckt >24.9 <25.1
pnpemit18a100_old = AREA pnpemit18 >99.9 <100.1
pnpemit18a100_ckt_old = AREA pnpemit18_ckt >99.9 <100.1
pnpemit33 = pnpemit AND DG
pnpemit33_ckt = pnpemit_ckt AND DG
pnpemit33a4_old   = AREA pnpemit33 >3.9 <4.1
pnpemit33a4_ckt_old   = AREA pnpemit33_ckt >3.9 <4.1
pnpemit33a25_old  = AREA pnpemit33 >24.9 <25.1
pnpemit33a25_ckt_old  = AREA pnpemit33_ckt >24.9 <25.1
pnpemit33a100_old = AREA pnpemit33 >99.9 <100.1
pnpemit33a100_ckt_old = AREA pnpemit33_ckt >99.9 <100.1

psd    = psd2 NOT (pnpemit OR pnpemit_ckt)

//*Define NPN Device
dnwnpn  = DNW AND DMPNP
npnemit = (nsd2 INTERACT dnwnpn) NOT MOSCKT
npnemit_ckt = (nsd2 INTERACT dnwnpn) AND MOSCKT

nwell1  = nwell INTERACT DNW
dnw1    = DNW OR nwell1
dnwell  = copy dnw1
//dnwell  = STAMP dnw1 BY nwell

npnemit18 = npnemit NOT DG
npnemit18_ckt = npnemit_ckt NOT DG
npnemit18a4_old   = AREA npnemit18 >3.9 <4.1
npnemit18a4_ckt_old   = AREA npnemit18_ckt >3.9 <4.1
npnemit18a25_old  = AREA npnemit18 >24.9 <25.1
npnemit18a25_ckt_old  = AREA npnemit18_ckt >24.9 <25.1
npnemit18a100_old = AREA npnemit18 >99.9 <100.1
npnemit18a100_ckt_old = AREA npnemit18_ckt >99.9 <100.1
npnemit33 = npnemit AND DG
npnemit33_ckt = npnemit_ckt AND DG
npnemit33a4_old   = AREA npnemit33 >3.9 <4.1
npnemit33a4_ckt_old   = AREA npnemit33_ckt >3.9 <4.1
npnemit33a25_old  = AREA npnemit33 >24.9 <25.1
npnemit33a25_ckt_old  = AREA npnemit33_ckt >24.9 <25.1
npnemit33a100_old = AREA npnemit33 >99.9 <100.1
npnemit33a100_ckt_old = AREA npnemit33_ckt >99.9 <100.1

nsd    = nsd2 NOT (npnemit OR npnemit_ckt)

#IFDEF VIR_ART FALSE

//* Logic operation for NC,PC
nwellup   = SIZE NW  BY 2.15
lognc     = nwellup AND SN
NC        = iNC OR lognc

spnwell   = NW AND SP
ncszup    = SIZE NC BY 0.6
sramnc    = spnwell AND ncszup
PC        = iPC OR sramnc

//*Gate extraction to distinguish 1.8 and 3.3 V transistor
ngate18a = ngate NOT DG 
nsramgate18_old = (ngate18a AND NC) AND OPCB
pgate18a  = pgate NOT DG
psramgate18_old = (pgate18a AND PC) AND OPCB
pgat18    = pgate18a NOT psramgate18

//*Define Sram cell(NPG,NPD) based on sram document(TD-SM18-CL-2002V3P.doc)
npgd18ps = AREA nsramgate18 >=0.0638 < 0.064
npgd18pd = AREA nsramgate18 >=0.045 < 0.046
ngat18  = (ngate18a NOT npgd18ps) NOT npgd18pd

#ENDIF

#IFDEF VIR_ART TRUE
//*Gate extraction to distinguish 1.8 and 3.3 V transistor
pgat18  = pgate NOT DG
ngat18  = ngate NOT DG

#ENDIF

//*Gate extraction to distinguish 1.8 and 3.3 V transistor
ngat33   = ngate AND DG
pgat33   = pgate AND DG
nsramgate33_old = ngat33 AND OPCB 
psramgate33_old = pgat33 AND OPCB
nsramgate33_se = nsramgate33_old NOT sram_npd33_none_layers
psramgate33_se = psramgate33_old NOT sram_ppl33_none_layers
//npd33_ckt(w/l=0.44u/0.3u,area=0.132) 
//npg33_ckt(w/l=0.28u/0.36u,area=0.1008)
//pl33_ckt(w/l=0.28u/0.31u,area=0.0868)
nsramgate33pd = (AREA nsramgate33_se >=0.132<0.133) TOUCH nsd == 2 
nsramgate33pg = (AREA nsramgate33_se >=0.1008<0.101) TOUCH nsd == 2
psramgate33pl = (AREA psramgate33_se >=0.0868<0.087) TOUCH psd == 2

//*Gate for Medium 1.8V and 3.3V MOS
//ngmedium33 = ngat33a AND MVN
ngmedium33i = ngat33 AND MVN
pgmedium33i = pgat33 AND MVP
ngmedium33_old  = ngmedium33i NOT MOSCKT
pgmedium33  = pgmedium33i NOT MOSCKT
ngmedium33_ckt_old = ngmedium33i AND MOSCKT
pgmedium33_ckt = pgmedium33i AND MOSCKT

//ngmedium18 = ngat18a AND MVN
ngmedium18i = ngat18 AND MVN
pgmedium18i = pgat18 AND MVP
ngmedium18_old  = ngmedium18i NOT MOSCKT
pgmedium18_old  = pgmedium18i NOT MOSCKT
ngmedium18_ckt_old = ngmedium18i AND MOSCKT
pgmedium18_ckt_old = pgmedium18i AND MOSCKT

//ngat33b    = ngat33a NOT ngmedium33
//ngat18b    = ngat18a NOT ngmedium18
ngat33b    = ngat33 NOT ngmedium33i
ngat18b    = ngat18 NOT ngmedium18i
pgat33a    = pgat33 NOT pgmedium33i
pgat18a    = pgat18 NOT pgmedium18i

//*Gate for Native NMOS
ngnative33_old = (ngat33b AND PSUB) NOT MOSCKT
ngnative33_ckt_old = (ngat33b AND PSUB) AND MOSCKT
ngnative18_old = (ngat18b AND PSUB) NOT MOSCKT
ngnative18_ckt_old = (ngat18b AND PSUB) AND MOSCKT

ngat33c    = ngat33b NOT ngnative33
ngat18c    = ngat18b NOT ngnative18


//*Gate for Normal 1.8V and 3.3V MOS
ngate18i    = ngat18c NOT RFDEV
ngate18_rf  = (ngat18c NOT ngate18i) NOT DNWTR
ngate18_old     = (ngate18i NOT MOSCKT) NOT DNWTR
ngate18_ckt_old = (ngate18i AND MOSCKT) NOT DNWTR

ngate33i    = ngat33c NOT RFDEV
ngate33_rf  = (ngat33c NOT ngate33i) NOT DNWTR
ngate33_old     = (ngate33i NOT MOSCKT) NOT DNWTR
ngate33_ckt_old = (ngate33i AND MOSCKT) NOT DNWTR

pgate18i    = pgat18a NOT RFDEV
pgate18_rf  = (pgat18a NOT pgate18i) NOT DNWTR
pgate18_old     = (pgate18i NOT MOSCKT) NOT DNWTR
pgate18_ckt_old = (pgate18i AND MOSCKT) NOT DNWTR

pgate33i    = pgat33a NOT RFDEV
pgate33_rf  = (pgat33a NOT pgate33i) NOT DNWTR
pgate33_old     = (pgate33i NOT MOSCKT) NOT DNWTR
pgate33_ckt_old = (pgate33i AND MOSCKT) NOT DNWTR

//*Define DNW MODFET device layer.
dnwn18gt_6t_ckt_old = (((ngate18i AND MOSCKT) AND DNWTR) INTERACT DNW) NOT NFDMK
dnwn18gt_4t_ckt_old = (((ngate18i AND MOSCKT) AND DNWTR) INTERACT DNW) AND NFDMK

dnwn33gt_6t_ckt_old = (((ngate33i AND MOSCKT) AND DNWTR) INTERACT DNW) NOT NFDMK
dnwn33gt_4t_ckt_old = (((ngate33i AND MOSCKT) AND DNWTR) INTERACT DNW) AND NFDMK

dnwp18gt_6t_ckt_old = (((pgate18i AND MOSCKT) AND DNWTR) INTERACT DNW) NOT NFDMK
dnwp18gt_4t_ckt_old = (((pgate18i AND MOSCKT) AND DNWTR) INTERACT DNW) AND NFDMK

dnwp33gt_6t_ckt_old = (((pgate33i AND MOSCKT) AND DNWTR) INTERACT DNW) NOT NFDMK
dnwp33gt_4t_ckt_old = (((pgate33i AND MOSCKT) AND DNWTR) INTERACT DNW) AND NFDMK

dnwngate18_ckt = ngate18_ckt INTERACT DNW
dnwngate33_ckt = ngate33_ckt INTERACT DNW
dnwpgate18_ckt = pgate18_ckt INTERACT DNW
dnwpgate33_ckt = pgate33_ckt INTERACT DNW

ndifd     = ndiff AND DNW

//* Gate for NMOS in Nwell
cngate18a  = cngate NOT DG
cngate33a  = cngate AND DG

//* Gate for varactor
cngate18_va= (cngate18a AND VARMOS) NOT RFDEV
cn18vargt_old  = GT ENCLOSE cngate18_va
cngate18   = cngate18a NOT cngate18_va

cngate33_va= (cngate33a AND VARMOS) NOT RFDEV
cn33vargt_old  = GT ENCLOSE cngate33_va
cngate33   = cngate33a NOT cngate33_va

cpgate18a  = cpgate NOT DG
cpgate33a  = cpgate AND DG

cpgate18_va = ((cpgate18a NOT RFDEV) NOT DNW) AND VARMOS
cp18var     = AA ENCLOSE cpgate18_va
cp18vargt_old   = GT ENCLOSE cpgate18_va
cpgate18    = cpgate18a NOT cpgate18_va

cpgate33_va = ((cpgate33a NOT RFDEV) NOT DNW) AND VARMOS
cp33var     = AA ENCLOSE cpgate33_va
cp33vargt_old   = GT ENCLOSE cpgate33_va
cpgate33    = cpgate33a NOT cpgate33_va

//*Divide the cont into polycont and dfcont
npolycont   = CT AND npoly
ppolycont   = CT AND ppoly

dfcont      = CT NOT (npolycont OR ppolycont)

ndfcont     = dfcont AND SN
pdfcont     = dfcont NOT SN

//*Define layer for ERC check
rnwell     = nwell TOUCH nwr
bnwell     = nwell INTERACT DMPNP

ptap_outside_dnw1= ptd NOT INTERACT dnw
ptap_outside_dnw = STAMP ptap_outside_dnw1 BY ptd

//Device

n18_none_layers = (((((((((((((((((NW or PSUB) or MVN) or MVP) or DG) or SP) or HRP) or RESP1) or RESAA) or RESNW) or HRPDMY) or VARMOS) or DMPNP) or DSTR) or INST) or INDMY) or FUSE) or GTFUSE) or EFUSE 

