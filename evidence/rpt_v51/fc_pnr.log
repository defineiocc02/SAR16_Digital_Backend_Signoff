    puts "##############################################################"
}
proc ok {name} {
    global stages
    lappend stages "$name=OK"
    puts "#### STAGE OK: $name"
}
proc fail {name msg} {
    global stages
    lappend stages "$name=FAILED($msg)"
    puts "##############################################################"
    puts "##  STAGE FAILED: $name"
    puts "##  $msg"
    puts "##############################################################"
}
proc run {name body} {
    if {[catch {uplevel 1 $body} msg]} {
        fail $name $msg
        return 1
    }
    ok $name
    return 0
}
