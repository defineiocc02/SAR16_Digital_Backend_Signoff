//////////////////////////////////////////////////////////////////////////////////////
// Device Formula                                                                   //
//                                                                                  //
// NGATE  = AA*GT*SN-NW; PGATE  = AA*GT*SP*NW; CNGATE = AA*GT*SN*NW                 //
//                                                                                  //
// ----------- ----------------------------- -------------------------------------- //
// Name        Description                   Device Layer Operation                 //
// ----------- ----------------------------- -------------------------------------- //
//                                                                                  //
// -------------------------------------------------------------------------------- //
// *Mix Signal Devices:                                                             //
// -------------------------------------------------------------------------------- //
//                                                                                  //
// MOSFET Type:                                                                     //
//                                                                                  //
// n18         1.8V NMOS                 (NGATE-DG-MVN-PSUB-DNWTR)                  //
// n33         3.3V NMOS                 (NGATE*DG-MVN-PSUB-DNWTR)                  //
// p18         1.8V PMOS                 (PGATE-DG-MVN-PSUB-DNWTR)                  //
// p33         3.3V PMOS                 (PGATE*DG-MVN-PSUB-DNWTR)                  //
// nnt18       1.8V Native NMOS          (NGATE-DG-MVN*PSUB)                        //
// nnt33       3.3V Native NMOS          (NGATE*DG-MVN*PSUB)                        //
// nmvt18      1.8V Medium NMOS          (NGATE-DG*MVN)                             //
// nmvt33      3.3V Medium NMOS          (NGATE*DG*MVN)                             //
// pmvt18      1.8V Medium PMOS          (PGATE-DG*MVP)                             //
//                                                                                  //
// n18_ckt         1.8V NMOS             (NGATE-DG-MVN-PSUB-DNWTR*MOSCKT)           //
// n18_dnw_ckt     1.8V NMOS             (NGATE-DG-MVN-PSUB*DNW*DNWTR*MOSCKT)       //
// n18_dnw_4t_ckt  1.8V NMOS             (NGATE-DG-MVN-PSUB*DNK*DNWTR*MOSCKT*NFDMK) //
// n33_ckt         3.3V NMOS             (NGATE*DG-MVN-PSUB-DNWTR*MOSCKT)           //
// n33_dnw_ckt     3.3V NMOS             (NGATE*DG-MVN-PSUB*DNW*DNWTR*MOSCKT)       //
// n33_dnw_4t_ckt  3.3V NMOS             (NGATE*DG-MVN-PSUB*DNK*DNWTR*MOSCKT*NFDMK) //
// p18_ckt         1.8V PMOS             (PGATE-DG-MVN-PSUB-DNWTR*MOSCKT)           //
// p18_dnw_ckt     1.8V PMOS             (PGATE-DG-MVN-PSUB*DNW*DNWTR*MOSCKT)       //
// p18_dnw_4t_ckt  1.8V PMOS             (PGATE-DG-MVN-PSUB*DNK*DNWTR*MOSCKT*NFDMK  //
// p33_ckt         3.3V PMOS             (PGATE*DG-MVN-PSUB-DNWTR*MOSCKT)           //
// p33_dnw_ckt     3.3V PMOS             (PGATE*DG-MVN-PSUB*DNW*DNWTR*MOSCKT)       //
// p33_dnw_4t_ckt  3.3V PMOS             (PGATE*DG-MVN-PSUB*DNK*DNWTR*MOSCKT*NFDMK) //
// nnt18_ckt       1.8V Native NMOS      (NGATE-DG-MVN*PSUB*MOSCKT)                 //
// nnt33_ckt       3.3V Native NMOS      (NGATE*DG-MVN*PSUB*MOSCKT)                 //
// nmvt18_ckt      1.8V Medium NMOS      (NGATE-DG*MVN*MOSCKT)                      //
// nmvt33_ckt      3.3V Medium NMOS      (NGATE*DG*MVN*MOSCKT)                      //
// pmvt18_ckt      1.8V Medium PMOS      (PGATE-DG*MVP*MOSCKT)                      //
//                                                                                  //
//--------------------------------------------------------------------------------- //
//                                                                                  //
// Resistor Type:                                                                   //
//                                                                                  //
// rnwsti             NWELL under STI              (RESNW*NW-RESCKT)                //
// rnwaa              NWELL under AA               (RESNW*NW*AA*SAB-RESCKT)         //
// rndifsab           Non-silicide N+ Diffusion    (RESAA*SN*AA*SAB-RESCKT)         //
// rndif              Silicide N+ Diffusion        (RESAA*SN*AA-SAB-RESCKT)         //
// rpdifsab           Non-silicide P+ Diffusion    (RESAA*SP*AA*SAB-RESCKT)         //
// rpdif              Silicide P+ Diffusion        (RESAA*SP*AA-SAB-RESCKT)         //
// rpposab            Non-silicide P+ Poly(2T)     (RESP1*SP*GT*SAB-RESP3T-RESCKT)  //
// rpposab_3t         Non-silicide P+ Poly(3T)     (RESP1*SP*GT*SAB*RESP3T-RESCKT)  //
// rppo               Silicide P+ Poly(2T)         (RESP1*SP*GT-SAB-RESP3T-RESCKT)  //
// rppo_3t            Silicide P+ Poly(3T)         (RESP1*SP*GT-SAB*RESP3T-RESCKT)  //
// rnposab            Non-silicide N+ Poly(2T)     (RESP1*SN*GT*SAB-RESP3T-RESCKT)  //
// rnposab_3t         Non-silicide N+ Poly(3T)     (RESP1*SN*GT*SAB*RESP3T-RESCKT)  //
// rnpo               Silicide N+ Poly(2T)         (RESP1*SN*GT-SAB-RESP3T-RESCKT)  //
// rnpo_3t            Silicide N+ Poly(3T)         (RESP1*SN*GT-SAB*RESP3T-RESCKT)  //
// rhrpo              High Resistance Poly(2T)     (GT*HRP*HRPDMY*SAB-RESP3T-RESCKT)//
// rhrpo_3t           High Resistance Poly(3T)     (GT*HRP*HRPDMY*SAB*RESP3T-RESCKT)//
// rm1                Metal1 Resistor              (M1R*M1)                         //
// rm2                Metal2 Resistor              (M2R*M2)                         //
// rm3                Metal3 Resistor              (M3R*M3)                         //
// rm4                Metal4 Resistor              (M4R*M4)                         //
// rm5                Metal5 Resistor              (M5R*M5)                         //
// rm6                Metal6 Resistor              (M6R*M6)                         //
//                                                                                  //
// rnwsti_ckt         NWELL under STI              (RESNW*NW*RESCKT)                //
// rnwaa_ckt          NWELL under AA               (RESNW*NW*AA*SAB*RESCKT)         //
// rndifsab_ckt       Non-silicide N+ Diffusion    (RESAA*SN*AA*SAB*RESCKT)         //
// rndif_ckt          Silicide N+ Diffusion        (RESAA*SN*AA-SAB*RESCKT)         //
// rpdifsab_ckt       Non-silicide P+ Diffusion    (RESAA*SP*AA*SAB*RESCKT)         //
// rpdif_ckt          Silicide P+ Diffusion        (RESAA*SP*AA-SAB*RESCKT)         //
// rpposab_ckt        Non-silicide P+ Poly(2T)     (RESP1*SP*GT*SAB-RESP3T*RESCKT)  //
// rpposab_3t_ck      Non-silicide P+ Poly(3T)     (RESP1*SP*GT*SAB*RESP3T*RESCKT)  //
// rppo_ckt           Silicide P+ Poly(2T)         (RESP1*SP*GT-SAB-RESP3T*RESCKT)  //
// rppo_3t_ckt        Silicide P+ Poly(3T)         (RESP1*SP*GT-SAB*RESP3T*RESCKT)  //
// rnposab_ckt        Non-silicide N+ Poly(2T)     (RESP1*SN*GT*SAB-RESP3T*RESCKT)  //
// rnposab_3t_ck      Non-silicide N+ Poly(3T)     (RESP1*SN*GT*SAB*RESP3T*RESCKT)  //
// rnpo_ckt           Silicide N+ Poly(2T)         (RESP1*SN*GT-SAB-RESP3T*RESCKT)  //
// rnpo_3t_ckt        Silicide N+ Poly(3T)         (RESP1*SN*GT-SAB*RESP3T*RESCKT)  //
// rhrpo_ckt          High Resistance Poly(2T)     (GT*HRP*HRPDMY*SAB-RESP3T*RESCKT)//
// rhrpo_3t_ckt       High Resistance Poly(3T)     (GT*HRP*HRPDMY*SAB*RESP3T*RESCKT)//
//                                                                                  //
//--------------------------------------------------------------------------------- //
//                                                                                  //
// DIODE Type:                                                                      //
//                                                                                  //
// ndio18        1.8V diode N+/PW              (DSTR*AA*SN-DG-PSUB)                 //
// ndio33        3.3V diode N+/PW              (DSTR*AA*SN*DG-PSUB)                 //
// nndio18       Native N+/PW Diode            (DSTR*AA*SN-DG*PSUB)                 //
// nndio33       Native N+/PW Diode            (DSTR*AA*SN*DG*PSUB)                 //
// pdio18        1.8V diode P+/NW              (DSTR*AA*SP-DG*NW)                   //
// pdio33        3.3V diode P+/NW              (DSTR*AA*SP*DG*NW)                   //
// ndiomvt18     1.8V MVT diode N+/PW          (DSTR*AA*SN-DG-PSUB*MVN)             //
// ndiomvt33     3.3V MVT diode N+/PW          (DSTR*AA*SN*DG-PSUB*MVN)             //
// pdiomvt18     1.8V MVT diode P+/NW          (DSTR*AA*SP-DG*NW*MVN)               //
// nwdio         NW/PW DIODE                   (DSTR*NW)                            //
// diobpw        Buried PWELL/Deep NWELL Diode (DSTR*SP*DNW)                        //
// dnwdio        DNW/PW DIODE                  (DSTR*DNW)                           //
//                                                                                  //
//--------------------------------------------------------------------------------- //
//                                                                                  //
// BJT Type:                                                                        //
//                                                                                  //
// pnp18a4     1.8V PNP BJT                  (DMPNP*SP*AA*NW-DG)                    //
// pnp18a25    1.8V PNP BJT                  (DMPNP*SP*AA*NW-DG)                    //
// pnp18a100   1.8V PNP BJT                  (DMPNP*SP*AA*NW-DG)                    //
// pnp33a4     3.3V PNP BJT                  (DMPNP*SP*AA*NW*DG)                    //
// pnp33a25    3.3V PNP BJT                  (DMPNP*SP*AA*NW*DG)                    //
// pnp33a100   3.3V PNP BJT                  (DMPNP*SP*AA*NW*DG)                    //
// npn18a4     1.8V NPN BJT                  (DMPNP*SN*AA*DNW-DG)                   //
// npn18a25    1.8V NPN BJT                  (DMPNP*SN*AA*DNW-DG)                   //
// npn18a100   1.8V NPN BJT                  (DMPNP*SN*AA*DNW-DG)                   //
// npn33a4     3.3V NPN BJT                  (DMPNP*SN*AA*DNW*DG)                   //
// npn33a25    3.3V NPN BJT                  (DMPNP*SN*AA*DNW*DG)                   //
// npn33a100   3.3V NPN BJT                  (DMPNP*SN*AA*DNW*DG)                   //
//                                                                                  //
//----------------------------------------------------------------------------------//
//                                                                                  //
// SMIC SRAM                                                                        //
//                                                                                  //
// NPD         Sram cell pull down           (NGATE*NC*OPC)                         //
// NPG         Sram Cell pass gate           (NGATE*NC*OPC)                         //
// PL          Sram cell pull up             (PGATE*PC*OPC)                         //
//                                                                                  //
//----------------------------------------------------------------------------------//
//                                                                                  //
// MOS Varactor                                                                     //
//                                                                                  //
// pvar18_ckt  MOSFET Varactor subckt        (CNGATE-DG*VARMOS-RFDEV)               //
// pvar33_ckt  MOSFET Varactor subckt        (CNGATE*DG*VARMOS-RFDEV)               //
//                                                                                  //
//----------------------------------------------------------------------------------//
//                                                                                  //
// Special Capacitor                                                                //
//                                                                                  //
// C1          1.8V NMOS in nwell            (CNGATE-DG)                            //
// C2          3.3V NMOS in nwell            (CNGATE*DG)                            //
// CPM         Metal1/poly Capacitor         (M1*GT*CAPBP)                          //
// mim         MIM Capacitor                 (MIM*M5[M4,M3,M2]*V5[V4,V3,V2])        //
// mim2        MIM Capacitor                 (MIM*M5[M4,M3,M2]*V5[V4,V3,V2])        //
// mim_ckt     MIM subckt                    (MIM*M5[M4,M3,M2]*V5[V4,V3,V2])        //
// mim2_ckt    MIM subckt                    (MIM*M5[M4,M3,M2]*V5[V4,V3,V2])        //
//                                                                                  //
//////////////////////////////////////////////////////////////////////////////////////


//////////////////////////////////////////////////////////////////////////////////////
//                             Environment Setting                                  //
//////////////////////////////////////////////////////////////////////////////////////

//WARNING: Please read the usage in readme before running LVS.

//-------------------------------------------------------------------------------------
//*OPTION 1: Define TOP Metal. The value can be 6, 5, 4, 3

#DEFINE TOPMETAL 6
//-------------------------------------------------------------------------------------
//*OPTION 2: Define ERC Check or Not. The value can be TRUE or FALSE(Upper Case).

#DEFINE ERCCHECK TRUE
//-------------------------------------------------------------------------------------
//*OPTION 3: Define Top Metal type. The value can be 9K, 22K, 34K or 40K.
//* 9K(Upper Case) : Sheet Resistance of Top Metal is 0.0279 ohm/sq.
//* 22K(Upper Case): Sheet Resistance of Top Metal is 0.015 ohm/sq.
//* 34K(Upper Case): Sheet Resistance of Top Metal is 0.01 ohm/sq.
//* 40K(Upper Case): Sheet Resistance of Top Metal is 0.0083 ohm/sq.

#DEFINE TM_TYPE 9K
//-------------------------------------------------------------------------------------
//*OPTION 4: Define Model name of the Memory for Virage or Artisan Library.
//*TRUE(Upper Case): Model name of sram device is N18, P18.
//*FALSE(Upper Case):Model name of sram device is NPG, NPD, PL.

#DEFINE VIR_ART FALSE //*Can be TRUE or FALSE
//-------------------------------------------------------------------------------------
//*OPTION 5: Define MIM type.The value can be 1,2.

//*1: Model name is mim or mim_ckt,The C0 is 0.969 fF/um^2.
//*2: Model name is mim2 or mim2_ckt,The C0 is 1.99 fF/um^2.

#DEFINE MIM_TYPE 1 
//--------------------------------------------------------------------------------------
//*OPTION 6: Define RC run or not; The value can be TRUE or FALSE.

#DEFINE RC_RUN FALSE
//--------------------------------------------------------------------------------------
//*OPTION 7: Extract EFUSE_res or not;
//*Default value is FALSE.

#DEFINE EFUSE_RES TRUE
//--------------------------------------------------------------------------------------
//*OPTION 8: Define BJT_MIS_MODE; The value can be 0 or 1.

#DEFINE BJT_MIS_MODE 1
//--------------------------------------------------------------------------------------
//*OPTION 9: Define MIM_MIS_MODE; The value can be 0 or 1.

#DEFINE MIM_mismod 1
//--------------------------------------------------------------------------------------
//*OPTION 10: Define RES_MIS_MODE; The value can be 0 or 1.

#DEFINE RES_mismod 1
//--------------------------------------------------------------------------------------
//*OPTION 11: Define VAR_MIS_MODE; The value can be 0 or 1.

#DEFINE VAR_MIS_MODE 1
//--------------------------------------------------------------------------------------
//*OPTION 12: Compare diode number and connectivity or not for Parasitic DIODE.
//The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE PARASI_DIO_CMP_DNW FALSE
//--------------------------------------------------------------------------------------
//*OPTION 13: Compare diode number and connectivity or not for Parasitic DIODE.
//The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE PARASI_DIO_CMP_NW FALSE
//--------------------------------------------------------------------------------------
//*OPTION 14: Compare parameters for parasitic DIODE.The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE PARASI_DIO_Property_CMP_DNW FALSE
//--------------------------------------------------------------------------------------
//*OPTION 15: Compare parameters for parasitic DIODE.The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE PARASI_DIO_Property_CMP_NW FALSE
//--------------------------------------------------------------------------------------
//*OPTION 16: Turn on nwell floating check or not. The value can be TRUE or FALSE(Upper Case).
//*Nwell resistor and BJT are not checked.
//*Default value is FALSE.

#DEFINE NWELL_FLOATING_CHECK FALSE
//--------------------------------------------------------------------------------------
//*OPTION 17: Turn on nwell not connecting to power check or not. The value can be TRUE or FALSE(Upper Case).
//*Nwell resistor and BJT are not checked.
//*Default value is FALSE.

#DEFINE NWELL_NOT_TO_POWER_CHECK TRUE
//--------------------------------------------------------------------------------------
//*OPTION 18: Turn on pwell not connecting to ground check or not. The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE PWELL_NOT_TO_GROUND_CHECK TRUE
//--------------------------------------------------------------------------------------
//*OPTION 19: Define whether to use CASE-SENSIVITY.The value can be TRUE or FALSE(Upper Case).

#DEFINE CASE_SENSITIVITY FALSE
//--------------------------------------------------------------------------------------
//*OPTION 20: Define the back annotation flow.The value can be 1 or 2,Default value is 1.
//*1: extrview flow,LVS will reserve some extra parameters for back annotation.
//*2: netlist flow,LVS will not reserve the back annotation parameters.

#DEFINE Back_Annotation_Flow 2 
//--------------------------------------------------------------------------------------
//*OPTION 21: compare PJ parameter or not for DIODE.The value can be TRUE or FALSE(Upper Case).
//*Default value is FALSE.

#DEFINE DIO_PJ FALSE
//--------------------------------------------------------------------------------------

VARIABLE mos_err 5
VARIABLE dio_err 5
VARIABLE bjt_err 5
VARIABLE res_err 5
VARIABLE var_err 5
VARIABLE cap_err 5

SOURCE PATH "/home/<user>/sar16_work/proj_paper_core/calibre/lvs/sar16.cdl"
SOURCE PRIMARY "sar_digi_paper_core"
SOURCE SYSTEM SPICE

LAYOUT PATH "/home/<user>/sar16_work/proj_paper_core/calibre/sar_digi_paper_core_merged.gds"
LAYOUT PRIMARY "sar_digi_paper_core"
LVS GLOBALS ARE PORTS                 YES
PRECISION 10000
LAYOUT SYSTEM GDSII

#IFDEF CASE_SENSITIVITY TRUE
LAYOUT CASE YES 
SOURCE CASE YES 
LVS COMPARE CASE YES
#ENDIF

LVS REPORT "/home/<user>/sar16_work/proj_paper_core/calibre/lvs/lvs.rep"
LVS REPORT OPTION A B C D S

UNIT CAPACITANCE FF
UNIT RESISTANCE OHM
UNIT LENGTH U

ERC MAXIMUM RESULTS 100
ERC RESULTS DATABASE erc.db
ERC SUMMARY REPORT erc.rep

#IFDEF RC_RUN TRUE
PEX NETLIST LUMPED "lumped.dist" HSPICE LAYOUT GROUND VSS MASK
PEX REPORT LUMPED none
PEX REPORT DISTRIBUTED none
PEX NETLIST DISTRIBUTED "distributed.dist" HSPICE LAYOUT GROUND VSS MASK
MASK SVDB DIRECTORY "svdb" QUERY CCI// Please modify CCI to XRC while you're running XRC flow.
#ELSE
MASK SVDB DIRECTORY "svdb" QUERY
#ENDIF

FLAG SKEW YES
FLAG OFFGRID YES
LVS ISOLATE SHORTS             YES
LVS SPICE PREFER PINS          YES
LVS RECOGNIZE GATES            NONE
LVS ABORT ON SUPPLY ERROR      NO
LVS ALL CAPACITOR PINS SWAPPABLE NO
LVS IGNORE PORTS               NO
LVS CHECK PORT NAMES           YES
LVS REDUCE PARALLEL BIPOLAR    YES
LVS REDUCE PARALLEL MOS        YES
LVS REDUCE PARALLEL DIODES     YES
LVS REDUCE PARALLEL CAPACITORS YES
LVS REDUCE PARALLEL RESISTORS  YES
LVS REDUCE SERIES RESISTORS    YES
LVS REDUCE SERIES CAPACITORS   YES
LVS REDUCE SPLIT GATES         YES 
LVS FILTER UNUSED OPTION AB RC RE RG
LVS PROPERTY RESOLUTION MAXIMUM 65536
LAYOUT BASE LAYER AA SN SP GT CT NW MIM
VIRTUAL CONNECT COLON YES
LVS SPICE MULTIPLIER NAME "M" "MR"

//VIRTUAL CONNECT NAME "?" 

LVS GROUND NAME "VSS" "SAVSS?" "?GND?" "?VSS?" "?vss?" "?gnd?"
LVS POWER NAME  "VDD" "SAVDD?" "?VDD?" "?VCC?" "?vcc?" "?vdd?"

//////////////////////////////////////////////
// Layer Mapping                            //  
//////////////////////////////////////////////
LAYER AA        10 12 13 // Active Area 
LAYER NW        14 // N-Well
LAYER iPC       16 // PCH HV VT adjust
LAYER iNC       21 // NCH HV VT adjust
LAYER DNW       19 // Deep N Well imp for substrate noise suppression

LAYER MAP       19 DATATYPE 2 1920
LAYER DNWTR     1920 //DNW MOS marking layer    

LAYER DG        29 // Dual Gate 
LAYER GT        30 // Poly Gate
LAYER HRP       39 // High Resistant Poly Imp
LAYER SN        40 // N+ S/D implant
LAYER SP        43 // P+ S/D implant
LAYER MVP       44 // Medium Vtp adjust
LAYER MVN       45 // Medium Vtn adjust
LAYER SAB       48 // Resist Protect Oxide/Salicide Block
LAYER CT        50 // Contact Hole
LAYER MIM       58 // Top plate of MIM Capacitor
LAYER M1        61 // Metal1
LAYER M2        62 // Metal2
LAYER M3        63 // Metal3
LAYER M4        64 // Metal4
LAYER M5        65 // Metal5
LAYER M6        66 // Metal6
LAYER M1TXT     141 // Metal-1 Text Layer(Only for 40nm and above technology)
LAYER M2TXT     142 // Metal-2 Text Layer(Only for 40nm and above technology)
LAYER M3TXT     143 // Metal-3 Text Layer(Only for 40nm and above technology)
LAYER M4TXT     144 // Metal-4 Text Layer(Only for 40nm and above technology)
LAYER M5TXT     145 // Metal-5 Text Layer(Only for 40nm and above technology)
LAYER M6TXT     146 // Metal-6 Text Layer(Only for 40nm and above technology)

LAYER V1        70 // Via1
LAYER V2        71 // Via2
LAYER V3        72 // Via3
LAYER V4        73 // Via4
LAYER V5        74 // Via5
LAYER PSUB      85 // Native Device Region
LAYER MAP       63 TEXTTYPE 63 363
LAYER IGNORE    363

//LAYER SURNW    209  // Dummy layer on surrounding NW for DRC check

LAYER RESNW     95 // Dummy for NW resistor
LAYER MAP       96 DATATYPE 0 960
LAYER RESP1     960 // Dummy for Poly resistor
LAYER MAP       96 DATATYPE 1 961
LAYER RESP3T    961 // Dummy for Poly resistor
LAYER RESAA     97 // Dummy for AA resistor
LAYER MAP       131 DATATYPE 1 300 // Dummy for psub
LAYER SUBD      300
LAYER OPCBA     100 // Blocking Layer for OPC operation on AA
LAYER OPCBP     101 // Blocking Layer for OPC operation on GT
LAYER OPCBM     102 // Blocking Layer for OPC operation on M1
LAYER DMPNP     134 // Dummy for BJT
LAYER CAPBP     137 // Dummy for Cap
LAYER DSTR      138 // Dummy for Diode
LAYER M1R       171 // Dummy for Metal1 Resistor
LAYER M2R       172 // Dummy for Metal2 Resistor
LAYER M3R       173 // Dummy for Metal3 Resistor
LAYER M4R       174 // Dummy for Metal4 Resistor
LAYER M5R       175 // Dummy for Metal5 Resistor
LAYER M6R       176 // Dummy for Metal6 Resistor

LAYER MAP       131 DATATYPE 5 1315
LAYER NFDMK     1315 //LVS marking layer for mos multiple fingers
LAYER RFDEV     181 // Dummy for RF device
LAYER RFMOSD    182 // Dummy for RF MOSFET Drain
LAYER VARMOS    93  // Dummy for MOS Type varactor.
LAYER VARJUN    183 94 // Dummy for Junction Diode
LAYER HRPDMY    210 // Dummy patten for HRP Resistor

LAYER MAP       131 DATATYPE 6 1316
LAYER MIMCKT    1316 //LVS dummy layer for subckt MIM

LAYER MAP       131 DATATYPE 2 1312
LAYER MOSCKT    1312 //LVS dummy layer to distinguish bsim mos and subckt mos

LAYER MIMDMY    211 // Dummy for MIM capacitor
LAYER INDMY     212 // Dummy for Inductor
LAYER MAP       211 DATATYPE 1 2111
LAYER MOMDMY    2111 // MOM Dummy layer
LAYER MAP       183 DATATYPE 2 1832 
LAYER RF3T      1832
LAYER MAP       131 DATATYPE 3 1313
LAYER RESCKT    1313 //LVS subckt resistor dummy layer

LAYER INST      60 // SRAM bitcell ,edge cell, strap cell or Instance Outline;SRAM bitcell ,edge cell ,stap cell area Block layer 

LAYER ESD1      41 // ESD Implant for 1
LAYER MAP       133 DATATYPE 3 1333
LAYER ESDIO2    1333 //Dummy layer for SMIC external ESD devices and protection circuits
LAYER MAP       133 DATATYPE 1 1331
LAYER ESD5V     1331 //Dummy layer for 5V tolerant I/O device identification

LAYER FUSE      81 // Fuse Window
LAYER MAP       81 DATATYPE 152 8152
LAYER FUSEMK1   8152 //Marking all E-Fuse area
LAYER MAP       81 DATATYPE 1 811
LAYER GTFUSE    811 //Marking layer for the rectangular GT shape connecting the cathode end and anode end
LAYER MAP       81 DATATYPE 2 812
LAYER EFUSE     812 //Marking layer for an electrical fuse

#IFDEF TOPMETAL 6
TEXT LAYER 146 ATTACH 146 metal6
PORT LAYER TEXT 146
TEXT LAYER 66 ATTACH 66 metal6
PORT LAYER TEXT 66
