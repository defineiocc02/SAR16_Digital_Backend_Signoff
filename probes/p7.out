########## C. probe_fix_pins_pg.tcl (someone was probing this already) ##########
# probe_fix_pins_pg.tcl -- two remaining defects, interrogated not guessed.
#
# A. 28 block pins exist in the netlist and in FC's database (IFACE_TERMINALS
#    total=232 signal=232) but not in the written GDS/LEF (204 port texts, and
#    the LEF is a TECHNOLOGY lef with zero MACRO/PIN records). So the loss is in
#    the WRITERS. write_lef <file> evidently emits the tech LEF; this release
#    should have a block-abstract writer. Find its spelling and its options.
#
# B. compile_pg warns
#        PGR-095: Strategy via rule is not defined.
#        Add appropriate via rule to get expected results and avoid runtime penalties.
#    and 3517 cells stay physically disconnected even though the logical
#    connection is complete (3720/3720) and the M1 rails exist (86 = 43 rows x
#    2 nets). A via rule is the named missing input, so probe how this release
#    wants it expressed.
set PNR /home/<user>/sar16_work/proj_paper_core/pnr
proc banner {s} { puts ""; puts "########## $s ##########" }
proc attempt {label script} {
    if {[catch {uplevel 1 $script} m]} { puts "  STEP-FAIL $label -> $m"; return 0 }
    puts "  STEP-OK   $label"; return 1
}
proc usage {cmd} { catch {$cmd -zzzbogus} u; puts "  usage[$cmd]: $u" }

open_lib $PNR/sar16_pnr_paper_core
open_block sar16_route_paper_core
puts "  cells=[sizeof_collection [get_cells -hier -quiet -filter "is_hierarchical==false"]]"
puts "  terminals=[sizeof_collection [get_terminals -quiet *]]"

banner "A1 which write_* commands exist"
foreach c {write_lef write_lef_abstract write_gds write_verilog write_def write_block_summary} {
    puts "  $c : [expr {[llength [info commands $c]] > 0 ? "EXISTS" : "absent"}]"
}

banner "A2 write_lef_abstract spellings -> /tmp/ab_*.lef"
foreach v {
    {"positional"   {write_lef_abstract /tmp/ab_pos.lef}}
    {"-output"      {write_lef_abstract -output /tmp/ab_out.lef}}
    {"-no_tech"     {write_lef_abstract -output /tmp/ab_nt.lef -no_tech}}
    {"-include_tech positional" {write_lef_abstract /tmp/ab_inc.lef -include_tech}}
} {
    set lbl [lindex $v 0]; set sc [lindex $v 1]
    attempt $lbl $sc
}
foreach f {/tmp/ab_pos.lef /tmp/ab_out.lef /tmp/ab_nt.lef /tmp/ab_inc.lef} {
    if {[file exists $f]} {
        set fh [open $f r]; set t [read $fh]; close $fh
        puts "  [format %-18s $f] bytes=[file size $f]  MACRO=[regexp -all -inline {^MACRO } $t]  PIN=[regexp -all -inline {  PIN } $t]"
    } else { puts "  [format %-18s $f] NOT WRITTEN" }
}

banner "B1 via-rule commands and set_pg_strategy options"
foreach c {create_pg_via_rule create_via_rule set_pg_via_rule set_pg_via_definition create_pg_via_def} {
    puts "  $c : [expr {[llength [info commands $c]] > 0 ? "EXISTS" : "absent"}]"
}
usage set_pg_strategy
usage create_pg_std_cell_conn_pattern

banner "B2 try variants of set_pg_strategy that mention a via rule"
attempt "recreate rail pattern" {create_pg_std_cell_conn_pattern rail_v4 -layers {METAL1}}
foreach v {
    {"-via_rule list" {set_pg_strategy sv1 -core -pattern {{name: rail_v4} {nets: {VDD VSS}}} -via_rule {{layers: {METAL1 METAL1}} {via_master: VIA12}}}}
    {"pattern via_rule kw" {set_pg_strategy sv2 -core -pattern {{name: rail_v4} {nets: {VDD VSS}} {via_rule: {layers: {METAL1 METAL1}}}}}}
} {
    set lbl [lindex $v 0]; set sc [lindex $v 1]
    attempt $lbl $sc
}

banner "B3 compile_pg with the pattern, and watch for PGR-095"
attempt "compile_pg sv1" {compile_pg -strategies sv1}
if {[catch {redirect /tmp/pg5.rpt {check_pg_connectivity}} m]} { puts "  check FAIL $m" } else {
    set fh [open /tmp/pg5.rpt r]; set t [read $fh]; close $fh
    set fw n/a; set fc n/a
    regexp -nocase {Number of floating wires:\s*(\d+)}     $t -> fw
    regexp -nocase {Number of floating std cells:\s*(\d+)} $t -> fc
    puts "  MEASURE floating_wires=$fw floating_std_cells=$fc"
}

banner "B4 what does the extracted netlist say the PG nets look like"
puts "  VDD nets=[sizeof_collection [get_nets -quiet VDD]]  VSS nets=[sizeof_collection [get_nets -quiet VSS]]"

puts "PROBE_FIX_DONE (nothing saved)"
exit 0

