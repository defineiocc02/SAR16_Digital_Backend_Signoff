////////////////////////Define BJT///////////////////////////////

DMACRO BJT_PRO proc_layer { 
       [PROPERTY A
        A = AREA(proc_layer)
       ]
}

DMACRO BJT_PRO_MIS proc_layer {
       [PROPERTY "AREA"
        "AREA" = AREA(proc_layer)
       ]
}

DMACRO BJT_RC proc_layer{
    #IFDEF Back_Annotation_Flow 1
    [PROPERTY m,FA
    #ENDIF
    #IFDEF Back_Annotation_Flow 2
    [PROPERTY m
    #ENDIF
    FA = AREA(proc_layer)
    m=1
   ]
}

DMACRO BJT_RC_MIS proc_layer{
    #IFDEF Back_Annotation_Flow 1
    [PROPERTY mismod_bjt,m,FA
    #ENDIF
    #IFDEF Back_Annotation_Flow 2
    [PROPERTY mismod_bjt,m
    #ENDIF
    m = 1
    FA = AREA(proc_layer)
    #IFDEF BJT_MIS_MODE 1
    mismod_bjt=1
    #ENDIF
    #IFDEF BJT_MIS_MODE 0
    mismod_bjt=0
    #ENDIF
   ]
}

