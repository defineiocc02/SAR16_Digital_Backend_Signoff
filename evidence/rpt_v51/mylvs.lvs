////////////////////////Define MOS///////////////////////////////

DMACRO MOS_PRO fet_seed sd_seed {
       [ PROPERTY W,L
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
       ]
}

DMACRO VAR_MIS fet_seed sd_seed {
        [ PROPERTY LR,WR,NF,MR,mismod_var
        NF = COUNT(fet_seed)
        WR = PERIM_CO(fet_seed,sd_seed)/(2*NF)
        LR = AREA(fet_seed)/(WR*NF)
        MR = 1

        #IFDEF VAR_MIS_MODE 0
         mismod_var = 0
        #ELSE
        #IFDEF VAR_MIS_MODE 1
         mismod_var = 1
        #ENDIF
        #ENDIF
        ]
}

DMACRO VAR_PARALLEL_REDUCE device_name{
       LVS REDUCE device_name PARALLEL yes
       [ effective LR,WR,NF
       LR = sum ( LR*NF )/sum ( NF )
       WR = sum ( WR*NF )/sum ( NF )
       NF = sum ( NF )
       ]
}

DMACRO MOS_XRC_PRO fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRS,NRD,M,NF,SD,SCA,SCB,SCC
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         A = 5E-06
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         M     = 1
         NF    = 1
         SD    = 0
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
            AS=AREA(S)*W/PER_S
            PS =perimeter(S)*W/PER_S
            AD =AS
            PD =PS
         }ELSE{
            AD=AREA(D)*W/PER_D
            PD = perimeter(D)*W/PER_D
            AS = AREA(S)*W/PER_S
            PS = perimeter(S)*W/PER_S
         }
         SA = W/sum(S::w/(S::a+0.5*L)) - 0.5*L
         SB = W/sum(S::w/(S::b+0.5*L)) - 0.5*L

         NRS=AS/(W*W)
         NRD=AD/(W*W)
         
         SCA= 0
         SCB= 0
         SCC= 0
        ]
}

DMACRO MOS_XRC_MIS fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRS,NRD,MR,NF,SD,SCA,SCB,SCC,mismod
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         A = 5E-06
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         MR    = 1
         NF    = 1
         mismod = 1
         SD    = 0
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
            AS=AREA(S)*W/PER_S
            PS =perimeter(S)*W/PER_S
            AD =AS
            PD =PS
         }ELSE{
            AD=AREA(D)*W/PER_D
            PD = perimeter(D)*W/PER_D
            AS = AREA(S)*W/PER_S
            PS = perimeter(S)*W/PER_S
         }
         SA = W/sum(S::w/(S::a+0.5*L)) - 0.5*L
         SB = W/sum(S::w/(S::b+0.5*L)) - 0.5*L

         NRS=AS/(W*W)
         NRD=AD/(W*W)
         
         SCA= 0
         SCB= 0
         SCC= 0
        ]
}

DMACRO NNT_MOS_XRC_PRO fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRS,NRD,M,NF,SD
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         A = 5E-06
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         M     = 1
         NF    = 1
         SD    = 0
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
            AS=AREA(S)*W/PER_S
            PS =perimeter(S)*W/PER_S
            AD =AS
            PD =PS
         }ELSE{
            AD=AREA(D)*W/PER_D
            PD = perimeter(D)*W/PER_D
            AS = AREA(S)*W/PER_S
            PS = perimeter(S)*W/PER_S
         }
         SA = W/sum(S::w/(S::a+0.5*L)) - 0.5*L
         SB = W/sum(S::w/(S::b+0.5*L)) - 0.5*L

         NRS=AS/(W*W)
         NRD=AD/(W*W)
         ]
}

DMACRO NNT_MOS_XRC_MIS fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRS,NRD,MR,NF,SD,mismod
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         A = 5E-06
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         MR    = 1
         NF    = 1
         mismod = 1
         SD    = 0
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
            AS=AREA(S)*W/PER_S
            PS =perimeter(S)*W/PER_S
            AD =AS
            PD =PS
         }ELSE{
            AD=AREA(D)*W/PER_D
            PD = perimeter(D)*W/PER_D
            AS = AREA(S)*W/PER_S
            PS = perimeter(S)*W/PER_S
         }
         SA = W/sum(S::w/(S::a+0.5*L)) - 0.5*L
         SB = W/sum(S::w/(S::b+0.5*L)) - 0.5*L

         NRS=AS/(W*W)
         NRD=AD/(W*W)
         ]
}

DMACRO SRAM_PRO fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
           AS = AREA(S)*W/PER_S
           PS = perimeter(S)*W/PER_S
           AD = AS
           PD = PS
         }ELSE{
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AREA(S)*W/PER_S
           PS = perimeter(S)*W/PER_S
         }
         ]
}
DMACRO SRAM_RC fet_seed sd_seed proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRD,NRS,MISMOD,GLOBALMOD
         W = PERIM_CO(fet_seed,sd_seed)/2
         L = AREA(fet_seed)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
           AS = AREA(S)*W/PER_S
           PS = perimeter(S)*W/PER_S
           AD = AS
           PD = PS
         }ELSE{
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AREA(S)*W/PER_S
           PS = perimeter(S)*W/PER_S
         }
          sa = 0         
          sb = 0
          nrd = 0
          nrs = 0
          mismod = 0 
          globalmod = 0  
         ]
}


