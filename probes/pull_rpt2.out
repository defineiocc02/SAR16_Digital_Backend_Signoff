=== collect_result.sh: where does it write? ===
28:RPT=$P/reports
29:OUT=${1:-$RPT/RESULT_CURRENT.env}
30:mkdir -p "$(dirname "$OUT")"
133:echo "fc_util=$(num "$P/pnr/reports/fc_util.rpt" 'Utilization Ratio:')"
134:echo "fc_block_area=$(num "$P/pnr/reports/fc_util.rpt" 'Total Area:')"
135:echo "fc_capacity_area=$(num "$P/pnr/reports/fc_util.rpt" 'Total Capacity Area:')"
143:for line in $(grep -ah 'STA_FMAX_EST corner=' "$P/pnr/reports/sta/sta_pc_summary.txt" 2>/dev/null \
154:    v=$(grep -ah "STA_DERATE_CHECK corner=slow tag=$t " "$P/pnr/reports/sta/sta_pc_derate.txt" 2>/dev/null \
177:} > "$OUT"
179:echo "wrote $OUT  ($(grep -cv '^#' "$OUT") keys)"

