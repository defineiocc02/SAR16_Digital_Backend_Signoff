# =============================================================================
# sar_reconstruction.sv is deliberately ABSENT: this core has no reconstruction
# datapath. See the module header of rtl/sar_digi_paper_core.sv for the textual
# evidence from the paper that the weighted sum is an off-chip function.
set SV_FILES [list $RTL_DIR/sar_calib_ctrl_serial.sv $RTL_DIR/srm_residue_lut.sv $RTL_DIR/srm_residue_estimator.sv $RTL_DIR/sar_digi_paper_core.sv]
/home/<user>/sar16_work/proj_paper_core/rtl/sar_calib_ctrl_serial.sv /home/<user>/sar16_work/proj_paper_core/rtl/srm_residue_lut.sv /home/<user>/sar16_work/proj_paper_core/rtl/srm_residue_estimator.sv /home/<user>/sar16_work/proj_paper_core/rtl/sar_digi_paper_core.sv
# ONE FILE PER analyze CALL. `analyze -format sverilog ... F1 F2 F3` is rejected
# in this release with
#     Error: extra positional option 'F2' (CMD-012)
# and the rejection aborts the WHOLE call -- so the single multi-file line this
# script used to carry analysed NOTHING, and the flow only appeared to work
# because `elaborate` auto-reads modules it cannot find off search_path. That
# makes the file list above non-authoritative for what actually gets compiled,
# which is exactly the kind of silent substitution this project keeps running
# into. Loop instead, so the list means what it says.
foreach F $SV_FILES {
    analyze -format sverilog -define SYNTHESIS $F
}
