# =============================================================================
# v4.2: isolate the constant-driven outputs BEFORE placement
# -----------------------------------------------------------------------------
# 28 of the 232 top-level signal ports are tied to a constant by the netlist:
#     weight_rd_data[3,6,9,13,17,21,24,28]   (8)
#     srm_residue_o[9], srm_residue_o[11..29] (20)
# They exist because the host fixes the interface widths -- a 30-bit weight word
# and a 30-bit residue word -- while the paper-aligned core only produces the low
# bits of each. A port driven by a constant has no NET, and this release's
# placer only creates pin geometry for ports that have one, so the routed GDS
# ended up with 204 port texts against a 232-port netlist. Calibre reported
#     Error: Different numbers of ports (see below).  (204 vs 183)
# and, more to the point, the macro was NOT integrable: a 30-bit port with 20 of
# its pins missing cannot be connected by the enclosing top.
#
# set_isolate_ports inserts a buffer on each such output. The buffer gives the
# port a real net, hence a real pin and a real driven value. The logical
# function is unchanged -- those bits are still zero, they are simply driven
# instead of being declared -- so every simulation result in
# tb/tb_sar16_paper_core.sv (Phase 4 checks "weight_rd_data is tied low") still
# holds.
#
# Detection is by query, not by a hardcoded list: DC is free to tie off a
# different set on a different run, and a stale hardcoded list would fail
# silently in exactly the way this whole exercise is trying to stop.
# =============================================================================
if {[catch {
    set _const_ports {}
    set _nout 0
    foreach_in_collection _p [get_ports -quiet -filter "direction==out"] {
        incr _nout
        set _pn [get_object_name $_p]
        set _drv 0
        set _nets [get_nets -quiet -of_objects $_p]
        if {[sizeof_collection $_nets] > 0} {
            set _dp [get_pins -quiet -of_objects $_nets -filter "direction==out"]
            if {[sizeof_collection $_dp] > 0} { set _drv 1 }
        }
        if {!$_drv} { lappend _const_ports $_pn }
    }
    puts "ISO_OUT_PORTS total=$_nout constant_driven=[llength $_const_ports]"
    foreach _cp $_const_ports { puts "  ISO_CONST_PORT $_cp" }
    if {[llength $_const_ports] > 0} {
        if {[catch {set_isolate_ports -type buffer [get_ports -quiet $_const_ports]} _m]} {
            puts "ISO_FAIL set_isolate_ports: $_m"
            puts "ISO_BLOCKER: the 28 constant-driven outputs will keep their missing pins."
        } else {
            puts "ISO_OK set_isolate_ports applied to [llength $_const_ports] port(s)"
        }
    } else {
        puts "ISO_NOTE no constant-driven output ports found"
    }
} _iso_err]} { puts "ISO_FAIL (contained): $_iso_err" }
ISO_OUT_PORTS total=146 constant_driven=0
