////////////////////////Define Diode//////////////////////////////////

DMACRO DIO_PRO seed_layer {
           #IFDEF RC_RUN TRUE
           #IFDEF Back_Annotation_Flow 1
           [PROPERTY A,P,M,W,L
           #ENDIF
           #IFDEF Back_Annotation_Flow 2
           [PROPERTY A,P,M
           #ENDIF
           #ENDIF

           #IFDEF RC_RUN FALSE
             [PROPERTY A,P,M
           #ENDIF

             A=area(seed_layer)
             P=perimeter(seed_layer)
             L=(P+SQRT(abs(P*P-16*A)))/4
             W=(P-SQRT(abs(P*P-16*A)))/4
             M=1
             ]
}

DEVICE D(pdio18)   pdio18  pdio18 nwell CMACRO DIO_PRO pdio18
DEVICE D(pdio33)   pdio33  pdio33 nwell CMACRO DIO_PRO pdio33
