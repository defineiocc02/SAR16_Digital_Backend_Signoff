# =============================================================================
# Power plan  (v4.1 -- this block previously had NONE)
# -----------------------------------------------------------------------------
# Without it Calibre reported, in order of discovery:
#   * DRC: `M1_6` and `BD_2a` each pinned at the 1000-result cap -- METAL1 had no
#     supply rails and there are no bond pads (this is a bare digital block);
#   * LVS: `WARNING: There is no data for layout net name VDD.` -> the layout had
#     no power connectivity at all, so it was compared against a powered netlist
#     and came back INCORRECT with "Different numbers of nets/instances" and
#     connectivity errors. Extraction itself was fine (556 kB netlist, 1158 devices).
#
# A rail plan is possible here: all 478 macros in the kit LEF declare
#     PIN VDD / PIN VSS  DIRECTION INOUT  USE power  SHAPE ABUTMENT  on METAL1
# so the tool can derive the rail geometry from the pin shapes.
#
# Every call is guarded and, on failure, asks the command for its own usage text.
# Guessing option names in this toolchain yields either CMD-010 or a silent no-op,
# and each guess would cost a full P&R run.
# =============================================================================
stage "power_plan"

##############################################################
##  STAGE: power_plan
##############################################################
# pg_try takes the command NAME separately from the SCRIPT. Deriving the name with
# `lindex $script 0` inside the failure handler looked harmless and was not: for a
# braced script that contains a quoted filter, e.g.
#     {connect_pg_net -net VDD [get_pins -hier -filter "name=~VDD"]}
# `lindex` raises `list element in quotes followed by "]"` (CMD-013), and that
# error escaped the handler and ABORTED THE WHOLE P&R at the power-plan stage
# (CMD-081, PNR_STATUS=INCOMPLETE). A diagnostic path must not be able to kill the
# flow it is diagnosing.
proc pg_try {label cname script} {
    if {[catch {uplevel 1 $script} m]} {
        puts "  PG_FAIL $label : $m"
        if {[catch {$cname -zzzbogus} u]} { puts "  PG_USAGE $cname : $u" }
        return 0
    }
    puts "  PG_OK   $label"
    return 1
}
# --- layer naming -------------------------------------------------------------
# The kit LEF writes `LAYER METAL1` while the Calibre deck writes `LAYER M1 61`.
# The first attempt used `-layers {M1}` and got
#     Error: Cannot find layer M1 in the library. (PGR-032)
# so the name is asked of the tool rather than assumed.
set PG_L1 ""
set PG_L2 ""
foreach cand {METAL1 M1} {
    if {[sizeof_collection [get_layers -quiet $cand]] > 0} { set PG_L1 $cand; break }
}
foreach cand {METAL2 M2} {
    if {[sizeof_collection [get_layers -quiet $cand]] > 0} { set PG_L2 $cand; break }
}
puts "  PG layer resolution: metal1='$PG_L1'  metal2='$PG_L2'"
  PG layer resolution: metal1='METAL1'  metal2='METAL2'
if {$PG_L1 eq ""} {
    puts "  PG_LAYERS available: [get_object_name [get_layers -quiet *]]"
    puts "FATAL: neither METAL1 nor M1 exists in this library; cannot build a power plan."
    exit 1
}
# Everything below runs inside ONE catch. A power plan that cannot be built must
# degrade to "no PG + a loud NOTE", never to a dead P&R run.
if {[catch {

set PG_NETS {VDD VSS}

# --- ORDER: the nets first, then the rails ----------------------------------
# `compile_pg -strategies core_pg` failed with
#     Error: Cannot find net VDD in the design. (PGR-046)
#     Warning: Automatic PG net connection through connect_pg_net is disabled.
# A block with no UPF and no PG ports has no VDD/VSS NETS yet, so the strategy has
# nothing to assign rails to. The switch that disables the automatic creation is an
# app option, and this release has no `create_pg_net` (a probe of the command list
# showed it absent), so enabling the option is the way in. `connect_pg_net -net`
# with a bare string is NOT: it wants a collection
#     Error: Nothing matched for -net (SEL-005)
# and the net does not exist yet, which is the whole problem.
# v4.2 FIX: the three calls below used to pass their arguments in the WRONG
# ORDER. The proc is `pg_try {label cname script}`, but they were written as
#     pg_try <label> <command-string> <option-name>
# so `uplevel 1 $script` tried to evaluate the option NAME as a Tcl command.
# That failed, was caught, and printed
#     PG_FAIL <label> :
# with an EMPTY message -- which is why the failure looked like a tool refusal
# rather than a bug in this file, and why plan.pgroute.auto_connect_pg_net was
# never actually set despite appearing to have been tried. The probe
# (scripts/pg_syntax_probe.tcl) confirmed the option IS supported here and that
# setting it changes
#     "Automatic PG net connection through connect_pg_net is disabled."
# into
#     "Successfully updated PG connection."
# so the whole power plan depended on this one transposed pair of arguments.
pg_try "auto_connect_pg_net"  set_app_options {set_app_options -name plan.pgroute.auto_connect_pg_net -value true}
pg_try "default power net"    set_app_options {set_app_options -name mv.pg.default_power_supply_net_name  -value VDD}
pg_try "default ground net"   set_app_options {set_app_options -name mv.pg.default_ground_supply_net_name -value VSS}
pg_try "connect_pg_net"       connect_pg_net {connect_pg_net -all_blocks -automatic}
if {[catch {
    puts "  PG_NETS_AFTER_CONNECT VDD=[sizeof_collection [get_nets -quiet VDD]] VSS=[sizeof_collection [get_nets -quiet VSS]]"
} e0]} { puts "  PG_NETS_QUERY failed: $e0" }

# Belt and braces: the probe showed set_app_options setting this option and
# connect_pg_net then reporting "Successfully updated PG connection.", so the
# option is set again here in the exact form the probe used.
pg_try "auto_connect_pg_net (probe form)" set_app_options {set_app_options -name plan.pgroute.auto_connect_pg_net -value true}

# =============================================================================
# v4.3 -> round-3 POWER PLAN  (recipe verified in the isolated copy)
# -----------------------------------------------------------------------------
# WHAT WAS WRONG (each point measured, not guessed -- see FINDINGS_CARD1B.md):
#   1. `create_via_rule ... -layer METAL1` -- there is NO -layer option (CMD-010).
#      PG vias need `set_pg_via_master_rule -contact_code <name>`, and <name> is the
#      LEF via-master name `via1`, NOT the man page's example `VIA12C`
#      (that one fails with PGR-055 "Cannot find contact code name VIA12C").
#   2. the -pattern keywords need COLONS:
#          {{pattern: std_rail}{nets: {VDD VSS}}}
#      The old `{{name std_rail}{nets {VDD VSS}}}` is not that grammar.
#   3. the METAL1 rails only reach their own row.  Distribution straps on METAL2 are
#      what give the rails somewhere to via UP to.  With no straps, compile_pg
#      committed 2 vias; with straps it committed 1460.
#   4. `-start` / `-stop` take ONE NUMBER each (the old code passed coordinate
#      PAIRS), and the two nets must be INTERLEAVED by half a pitch: issued at
#      identical coordinates the VSS straps were dropped as redundant
#      (VDD wires 43->60 = +17, VSS wires 72->72 = +0).
#   5. `compile_pg` takes `-via_rule`.
# AND the control-flow defect: every step used to be written as
#       set PG_OK [expr {$PG_OK && [pg_try ...]}]
# which SHORT-CIRCUITS.  One failure therefore meant the later steps were never even
# ATTEMPTED, and the whole verification tail sat inside `if {$PG_OK}` -- which is why
# the v4.3 run left no fc_pg.rpt and no PG_VERDICT at all.  A step that is skipped
# must still say so; a verdict must be produced either way.
# =============================================================================

# --- step ledger: each entry is {"label" ok} and EVERY step reports --------------
set PG_STEPS {}
set PG_FAILED 0
proc pg_step {label script} {
    global PG_STEPS PG_FAILED
    if {[catch {uplevel 1 $script} m]} {
        puts "  PG_FAIL $label : [string map [list \n { | }] $m]"
        lappend PG_STEPS [list $label 0]
        incr PG_FAILED
        return 0
    }
    puts "  PG_OK   $label"
    lappend PG_STEPS [list $label 1]
    return 1
}

pg_step "connect_pg_net" {connect_pg_net -all_blocks -automatic}
if {[catch {
    puts "  PG_NETS_AFTER_CONNECT VDD=[sizeof_collection [get_nets -quiet VDD]] VSS=[sizeof_collection [get_nets -quiet VSS]]"
} e0]} { puts "  PG_NETS_QUERY failed: $e0" }

pg_step "create_pg_std_cell_conn_pattern" [list create_pg_std_cell_conn_pattern std_rail -layers [list $PG_L1]]

# --- via master rule: the contact code is DISCOVERED, not assumed ---------------
set PG_VM_NAME ""
foreach cc {via1 via2 via3 VIA12C} {
    if {$PG_VM_NAME ne ""} { break }
    if {[catch {set_pg_via_master_rule pg_vm_$cc -contact_code $cc -via_array_dimension {2 1} -allow_multiple {0.2 0}} mv]} {
        puts "  PG_VIA_MASTER_FAIL $cc : [string map [list \n { | }] $mv]"
    } else {
        puts "  PG_VIA_MASTER_OK   $cc"
        set PG_VM_NAME pg_vm_$cc
    }
}
puts "  PG_VIA_MASTER_NAME '${PG_VM_NAME}'"
if {$PG_VM_NAME eq ""} {
    puts "  WARNING: no via master rule could be created; compile_pg will run without one"
    puts "           and the PG will stay physically disconnected (this is reported, not hidden)."
}

# --- strategy: COLON keywords ---------------------------------------------------
pg_step "set_pg_strategy" [list set_pg_strategy core_pg -core -pattern {{pattern: std_rail}{nets: {VDD VSS}}}]

# --- straps: numeric -start/-stop, both nets, INTERLEAVED by half a pitch -------
# The Y span is read from the block; it is never hardcoded, because the core area is
# a tool decision and pinning it here would bend the straps off the rows the moment
# `initialize_floorplan` lands on a different size.
if {$PG_L2 ne ""} {
    set PG_Y0 0.0 ; set PG_Y1 0.0
    if {[catch {
        set _flat [join [get_attribute [current_block] boundary] " "]
        set _ys {}
        foreach {_x _y} $_flat { lappend _ys $_y }
        set PG_Y0 [lindex [lsort -real $_ys] 0]
        set PG_Y1 [lindex [lsort -real $_ys] end]
    } _be]} { puts "  PG_STRAP_GEOM failed: $_be" }
    puts "  PG strap Y span: $PG_Y0 -> $PG_Y1"
    set PG_STRAP_PITCH 25.0
    # VDD at x = 0, 25, 50 ... ; VSS at x = 12.5, 37.5 ...  -- interleaved
    # -extend_low/-extend_high design_boundary_and_generate_pin sends the strap all the
    # way to the block boundary AND creates the supply PIN there.  Without it the
    # merged GDS has no named VDD/VSS geometry at all, and Calibre reports
    #   "There is no data for layout net name VDD"  -- after which the well/bulk
    # terminals get attached to whatever net Calibre can find, which showed up as a
    # single net (RST_N) carrying 15153 connections.
    pg_step "strap_VDD" [list create_pg_strap -net {VDD} -layer $PG_L2 -direction vertical \
                              -width 0.6 -pitch $PG_STRAP_PITCH -start $PG_Y0 -stop $PG_Y1 \
                              -extend_low design_boundary_and_generate_pin \
                              -extend_high design_boundary_and_generate_pin]
    pg_step "strap_VSS" [list create_pg_strap -net {VSS} -layer $PG_L2 -direction vertical \
                              -width 0.6 -pitch $PG_STRAP_PITCH \
                              -start [expr {$PG_Y0 + $PG_STRAP_PITCH / 2.0}] -stop $PG_Y1 \
                              -extend_low design_boundary_and_generate_pin \
                              -extend_high design_boundary_and_generate_pin]
} else {
    puts "  NOTE: no metal2 layer found; the rails will have nothing to via up to."
}

# --- bind the via rule to the strategy ------------------------------------------
# Built as a LITERAL braced string, not as nested [list ...]: the nested-list form is
# how the colons get lost, and losing a colon is the very bug being fixed here.  (The
# first version of this patch made exactly that mistake and the dry run caught it --
# `PG_FAIL set_pg_strategy_via_rule` -- before it could reach a 10-minute flow.)
set PG_VR_OK 0
if {$PG_VM_NAME ne ""} {
    set _vr_script "set_pg_strategy_via_rule pg_vr -via_rule \{\{intersection: adjacent\}\{via_master: $PG_VM_NAME\}\}"
    set PG_VR_OK [pg_step "set_pg_strategy_via_rule" $_vr_script]
}

# --- compile, WITH the via rule when we have one --------------------------------
if {$PG_VR_OK} {
    pg_step "compile_pg -via_rule" [list compile_pg -strategies {core_pg} -via_rule {pg_vr}]
} else {
    pg_step "compile_pg (no via rule available)" [list compile_pg -strategies {core_pg}]
}

# --- verification tail: ALWAYS RUNS, whatever the steps above did ----------------
# v4.3 put this inside `if {$PG_OK}`, so a strategy failure deleted the only evidence
# that could have explained it.  It now runs unconditionally.
proc pg_floating {path net} {
    if {![file exists $path]} { return -1 }
    if {[catch {set fh [open $path r]; set t [read $fh]; close $fh} _e]} { return -1 }
    set idx [string first "Verify net $net connectivity" $t]
    if {$idx < 0} { return -1 }
    set seg [string range $t $idx end]
    set n -1
    regexp -nocase {Number of floating std cells:\s*(\d+)} $seg -> n
    return $n
}
if {[catch {redirect $RPT/fc_pg.rpt { check_pg_connectivity }} m]} {
    puts "  PG_FAIL check_pg_connectivity : $m"
    puts "PG_VERDICT unavailable=1"
} else {
    # -1 means UNKNOWN, never 0.  The first version initialised these to 0 and then
    # parsed inside a catch; when the parse threw (an `end` used in an expr), the
    # regexps never ran and the code printed "floating_std_cells=0" for BOTH nets --
    # a perfect, entirely fabricated pass.  A verdict variable must start at
    # "unknown" so that a broken parse cannot be mistaken for a clean result.
    set _fw_vdd -1 ; set _fc_vdd -1 ; set _fw_vss -1 ; set _fc_vss -1
    set _parse_ok 1
    if {[catch {
        set fh [open $RPT/fc_pg.rpt r]; set _t [read $fh]; close $fh
        set _tlen [string length $_t]
        set _iv [string first "Verify net VDD connectivity" $_t]
        set _is [string first "Verify net VSS connectivity" $_t]
        if {$_iv >= 0} {
            set _vend [expr {$_is > 0 ? $_is - 1 : $_tlen}]
            set _sv [string range $_t $_iv $_vend]
            set _fw_vdd 0 ; set _fc_vdd 0
            regexp -nocase {Number of floating wires:\s*(\d+)}     $_sv -> _fw_vdd
            regexp -nocase {Number of floating std cells:\s*(\d+)} $_sv -> _fc_vdd
        }
        if {$_is >= 0} {
            set _ss [string range $_t $_is $_tlen]
            set _fw_vss 0 ; set _fc_vss 0
            regexp -nocase {Number of floating wires:\s*(\d+)}     $_ss -> _fw_vss
            regexp -nocase {Number of floating std cells:\s*(\d+)} $_ss -> _fc_vss
        }
    } _e]} { puts "PG_VERDICT parse failed: $_e" ; set _parse_ok 0 }
    # machine-readable, and split per net: one aggregate number cannot tell you that
    # VDD is clean while VSS is not.
    puts "PG_VERDICT_PARSE_OK $_parse_ok"
    puts "PG_VERDICT_NET VDD floating_wires=$_fw_vdd floating_std_cells=$_fc_vdd"
    puts "PG_VERDICT_NET VSS floating_wires=$_fw_vss floating_std_cells=$_fc_vss"
    if {$_parse_ok == 0 || $_fc_vdd < 0 || $_fc_vss < 0} {
        puts "PG_VERDICT_UNKNOWN: the connectivity report could not be read; this is NOT a pass."
    } elseif {$_fc_vdd == 0 && $_fc_vss == 0} {
        puts "PG_OK_ALL: every standard cell is tied to the power grid on both nets."
    } else {
        puts "PG_BLOCKER: cells still float (VDD=$_fc_vdd VSS=$_fc_vss)."
        puts "            check the PG_STEPS ledger above for the first failed step."
    }
}
pg_step "check_pg_drc" {check_pg_drc}
if {[catch {
    puts "  PG_NETS_FINAL VDD=[sizeof_collection [get_nets -quiet VDD]] VSS=[sizeof_collection [get_nets -quiet VSS]]"
} e2]} { puts "  PG_NETS_QUERY2 failed: $e2" }

# --- the ledger, printed last so a single grep shows the whole story -------------
puts "  --- PG step ledger ---"
foreach s $PG_STEPS { puts "  PG_STEP [expr {[lindex $s 1] ? "OK  " : "FAIL"}] [lindex $s 0]" }
puts "PG_STEPS_TOTAL [llength $PG_STEPS] PG_STEPS_FAILED $PG_FAILED"


} pg_err]} {
    # An error raised OUTSIDE pg_try (e.g. a Tcl-level one) lands here.
    puts "  PG_FATAL (contained, flow continues): $pg_err"
}
