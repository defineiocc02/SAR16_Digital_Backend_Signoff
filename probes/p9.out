########## D. the top's declaration of srm_residue_q and WEIGHT_WIDTH use ##########
79:    parameter int  WEIGHT_WIDTH      = 30,      // signed, Q8: LSB_0 = 256
135:    output logic signed [WEIGHT_WIDTH-1:0] w_wr_data,
139:    output logic signed [WEIGHT_WIDTH-1:0] weight_rd_data,
156:    output logic signed [WEIGHT_WIDTH-1:0] srm_residue_o
162:    logic signed [WEIGHT_WIDTH-1:0] srm_residue_q;
169:        .WEIGHT_WIDTH      (WEIGHT_WIDTH),
200:        .RESIDUE_WIDTH  (WEIGHT_WIDTH),
219:        .residue_q        (srm_residue_q)
222:    assign srm_residue_o = srm_residue_q;
228:    function automatic logic signed [WEIGHT_WIDTH-1:0] seed_w(input int k);
229:        logic signed [WEIGHT_WIDTH-1:0] v;
231:            v = WEIGHT_WIDTH'(REF_WEIGHT_LSB);
233:                v = v <<< 1;            // in WEIGHT_WIDTH bits: 256<<19 = 2^27 fits
289:            logic signed [WEIGHT_WIDTH-1:0] weight_tab [0:CAP_NUM-1];
327:        if (WEIGHT_WIDTH < 28)
328:            $error("sar_digi_paper_core: WEIGHT_WIDTH must hold LSB_0 << (CAP_NUM-1); 28 is the minimum for CAP_NUM=20, LSB_0=256.");
333:        if ((longint'(REF_WEIGHT_LSB) << (CAP_NUM-1)) > ((longint'(1) << (WEIGHT_WIDTH-2)) - 1))
334:            $error("sar_digi_paper_core: the ideal weight ramp LSB_0<<(CAP_NUM-1) overflows WEIGHT_WIDTH; raise WEIGHT_WIDTH.");

