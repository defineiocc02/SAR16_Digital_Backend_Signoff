//Define MIM

MIM_aux = MIM AND MIMCKT
MIM_sd  = MIM NOT MIM_aux

DMACRO MIM_MIS seed_layer C0_value {
       #IFDEF Back_Annotation_Flow 1        
           [PROPERTY LR,WR,mr,mismod_mim,FC
       #ENDIF
       #IFDEF Back_Annotation_Flow 2    
           [PROPERTY LR,WR,mr,mismod_mim
       #ENDIF
        A  = AREA(seed_layer)
        WR = PERIM_CO(MIM_aux,MIM_sd)/2
        LR = A/WR
        mr = 1
        C0 = C0_value*1e-3
        FC = C0*WR*LR*mr
           #IFDEF MIM_mismod 0
            mismod_mim=0
           #ENDIF
           #IFDEF MIM_mismod 1
            mismod_mim=1
           #ENDIF
        ]
}

DMACRO MIM_PRO seed_layer C0_value {
        #IFDEF RC_RUN TRUE
           #IFDEF Back_Annotation_Flow 1
               [PROPERTY L,W,m,FC
           #ENDIF
           #IFDEF Back_Annotation_Flow 2 
               [PROPERTY L,W,m
           #ENDIF
        #ENDIF
        #IFDEF RC_RUN FALSE
        [PROPERTY C
        #ENDIF
        A = AREA(seed_layer)
        P = PERIMETER(seed_layer)
        L = (P+SQRT(abs(P*P-16*A)))/4 
        W = (P-SQRT(abs(P*P-16*A)))/4
        m = 1
        C0 = C0_value*1e-3
        C  = C0*W*L*m
        FC = C
        ]
}

#IFDEF MIM_TYPE 1
#IFDEF TOPMETAL 6
DEVICE C(mim) mimcap MIM mimcap CMACRO MIM_PRO mimcap 0.969
DEVICE mim_ckt mimcap_ckt MIM(PLUS) mimcap_ckt(MINUS) <MIM_aux> <MIM_sd> CMACRO MIM_MIS mimcap_ckt 0.969
#ENDIF
#IFDEF TOPMETAL 5
DEVICE C(mim) mimcap MIM mimcap CMACRO MIM_PRO mimcap 0.969
DEVICE mim_ckt mimcap_ckt MIM(PLUS) mimcap_ckt(MINUS) <MIM_aux> <MIM_sd> CMACRO MIM_MIS mimcap_ckt 0.969
#ENDIF
#IFDEF TOPMETAL 4
