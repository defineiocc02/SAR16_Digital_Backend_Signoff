        puts "ERROR: no clock named $CLK was created by the SDC."
        puts "       Most likely cause: a variable inside {} in a waveform/edge"
        puts "       list, e.g. '-waveform {0.0 \$CLK_HALF}'. Braces suppress \$"
        puts "       substitution, DC receives the literal token, drops the command"
        puts "       WITHOUT an error, and no clock is created."
        exit 1
    }
    puts "INFO: clock '$CLK' period = [get_attribute [get_clocks $CLK] period] ns"
}
