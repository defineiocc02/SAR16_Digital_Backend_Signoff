#IFDEF EFUSE_RES TRUE
DMACRO RES_PRO_EFUSE res_seed res_ter {
       [PROPERTY W,L,R
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       RS= 330
       R=(L*RS)/W
       ]
}

DEVICE EFUSE_res efgate ppoly(PLUS) ppoly(MINUS) CMACRO RES_PRO_EFUSE efgate ppoly
#ENDIF

////////////////////////////Define Resistor//////////////////////////
//NON_METAL

DMACRO RES_PRO res_seed res_ter rsh_value dw_value dl_value {
#IFDEF RC_RUN TRUE
       #IFDEF Back_Annotation_Flow 1 
       [PROPERTY W,L,M,FR
       #ENDIF
       #IFDEF Back_Annotation_Flow 2
       [PROPERTY W,L,M
       #ENDIF
#ENDIF
#IFDEF RC_RUN FALSE
       [PROPERTY R
#ENDIF
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       M = 1
       RS    = rsh_value
       DW    = dw_value
       DL    = dl_value
       R     = (L-2*DL)*RS/(W-2*DW)
       FR    = R
       ]
}

DMACRO RES_FLAG res_seed res_ter rsh_value dw_value dl_value {
       #IFDEF Back_Annotation_Flow 1
          [PROPERTY W,L,MR,FR,flag_cc
       #ENDIF
       #IFDEF Back_Annotation_Flow 2
          [PROPERTY W,L,MR,flag_cc
       #ENDIF
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       MR = 1
       RS    = rsh_value
       DW    = dw_value
       DL    = dl_value
       R     = (L-2*DL)*RS/(W-2*DW)
       FR    = R
       flag_cc = 0
       ]
}

DMACRO RES_CKT res_seed res_ter rsh_value dw_value dl_value {
       #IFDEF Back_Annotation_Flow 1       
         [PROPERTY W,L,MR,FR
       #ENDIF
       #IFDEF Back_Annotation_Flow 2
         [PROPERTY W,L,MR
       #ENDIF
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       MR = 1
       RS    = rsh_value
       DW    = dw_value
       DL    = dl_value
       R     = (L-2*DL)*RS/(W-2*DW)
       FR    = R
       ]
}

DMACRO RES_MIS res_seed res_ter rsh_value dw_value dl_value {
       #IFDEF Back_Annotation_Flow 1
       [PROPERTY W,L,MR,FR,mismod_res
       #ENDIF
       #IFDEF Back_Annotation_Flow 2
       [PROPERTY W,L,MR,mismod_res
       #ENDIF
       #IFDEF RES_mismod 1
       mismod_res = 1
       #ENDIF
       #IFDEF RES_mismod 0
       mismod_res = 0
       #ENDIF
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       MR = 1
       RS    = rsh_value
       DW    = dw_value
       DL    = dl_value
       R     = (L-2*DL)*RS/(W-2*DW)
       FR    = R
       ]
}

DMACRO RES_MIS_FLAG res_seed res_ter rsh_value dw_value dl_value {
       #IFDEF Back_Annotation_Flow 1       
          [PROPERTY W,L,MR,FR,flag_cc,mismod_res
       #ENDIF
       #IFDEF Back_Annotation_Flow 2
          [PROPERTY W,L,MR,flag_cc,mismod_res
        #ENDIF
       #IFDEF RES_mismod 1
       mismod_res = 1
       #ENDIF
       #IFDEF RES_mismod 0
       mismod_res = 0
       #ENDIF
       W = PERIM_CO(res_seed,res_ter)/2
       L = AREA(res_seed)/W
       MR = 1
       RS    = rsh_value
       DW    = dw_value
       DL    = dl_value
       R     = (L-2*DL)*RS/(W-2*DW)
       FR    = R
       flag_cc = 0
       ]
}

